{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shears Dev",
  "version": "../package.json",
  "identifier": "dev.bluejutzu.shears.dev",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shears Dev",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#262624",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["mp4", "mov", "mkv", "webm", "m4v"],
        "name": "Video",
        "role": "Viewer"
      }
    ],
    "publisher": "Bluejutzu",
    "copyright": "Copyright © 2026 Bluejutzu",
    "category": "Video",
    "shortDescription": "A fast, lightweight video cutter",
    "longDescription": "Open a clip in a second, cut out what you don't need and export it, without waiting for a full editor to start.",
    "homepage": "https://github.com/Bluejutzu/shears",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBRTlEQTlFNEQ5QUQwMjkKUldRcDBKcE5udHJwdWhNN3ZOd25LWDdtckNXQyszYjFISTNEUzJhNmI4VDFhb1gxOHFsMTJCenEK",
      "endpoints": ["https://github.com/Bluejutzu/shears/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
