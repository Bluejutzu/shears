{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shears",
  "version": "0.1.0",
  "identifier": "dev.bluejutzu.shears",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shears",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#262624",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mp4", "mov", "mkv", "webm", "m4v"],
        "name": "Video",
        "role": "Viewer"
      }
    ]
  }
}
